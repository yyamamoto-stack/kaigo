{
  "manifest_version": 3,
  "name": "カイポケ 訪問介護計画書 自動入力ツール",
  "version": "2.16.1",
  "description": "カイポケの「訪問介護計画書 新規追加」画面へ、JSONデータをDOM操作のみで自動入力する社内ツール（内部API通信なし・人間操作を模倣した遅延つき／サービス設定のポップアップ別ウィンドウに対応）。権限はカイポケのURLのみに限定（claude.md 2-3参照）。",

  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],

  "host_permissions": [
    "https://*.kaipoke.biz/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "カイポケ自動入力",
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": [
        "https://*.kaipoke.biz/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
